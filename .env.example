# ============================================================
# SAR-DSS Environment Variables
# Copy this file to .env and adjust values for your deployment.
# ============================================================

# --- Backend -------------------------------------------------
APP_NAME=SAR-DSS
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+psycopg2://sar:dss_password@localhost:5432/sar_dss
POSTGRES_USER=sar
POSTGRES_PASSWORD=dss_password
POSTGRES_DB=sar_dss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin bootstrap account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sar-dss.aai.gov.in
ADMIN_PASSWORD=Admin@123

# Weather API (Open-Meteo - free, no key required). Optional custom provider.
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# Map tile provider for static map images in PDF reports
# Options: osm, carto
MAP_TILE_PROVIDER=carto

# --- Outbound egress (VPN / proxy routing, NOT Tor) -------------------------
# All outbound HTTP (weather API, static map image, browser map tiles) can be
# anonymized through private VPNs / proxies. Modes:
#   direct   - no proxy (default, unchanged behaviour)
#   rotate   - round-robin over OUTBOUND_PROXIES - a different exit per request
#   random   - random exit from the pool per request
#   failover - stick to the last working exit, fall through the pool on errors
#   guard    - Tor-style guard node: pin one entry hop per session (stable peer)
#   mixnet   - rotate random 2-hop circuits assembled from the proxy pool
#   chain    - multi-hop SOCKS tunnelling through OUTBOUND_PROXY_CHAIN nodes
#   relay    - URL forwarding relays (JSON via OUTBOUND_RELAY_URL, images via
#              OUTBOUND_IMAGE_RELAY_URL) - passes corp filters that block proxies
# OS-level VPNs (WireGuard / OpenVPN on the host) are detected automatically.
OUTBOUND_MODE=direct
# Comma separated proxy URLs used by rotate / random / failover / guard:
#   socks5://user:pass@127.0.0.1:1080,socks4://127.0.0.1:9050,http://127.0.0.1:8118
#   ssh://user@jump.example:22   -> spawns an SSH dynamic-tunnel ("poor man's VPN")
OUTBOUND_PROXIES=
# Two or more proxies joined by "->" for chain mode (private relay network):
#   socks5://nodeA:1080 -> socks5://nodeB:1080
OUTBOUND_PROXY_CHAIN=
# Relay mode - JSON/HTML relay (path format, e.g. https://r.jina.ai) and image
# relay for tiles/static maps (query format, e.g. https://wsrv.nl):
# OUTBOUND_RELAY_URL=https://r.jina.ai
# OUTBOUND_IMAGE_RELAY_URL=https://wsrv.nl
OUTBOUND_CONNECT_TIMEOUT=15

# Report storage directory
REPORT_DIR=./reports

# --- Frontend ------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
